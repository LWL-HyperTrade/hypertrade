# =============================================================================
# HyperTrade — AI agent worker (separate Railway service)
# Copy:  cp workers/ai-agent/.env.example workers/ai-agent/.env
# Docs: docs/AI_AGENTS.md · docs/ENVIRONMENT.md
# Deploy separately from the FastAPI backend. Same Supabase project.
# =============================================================================

# --- Required ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Same "secret" / service_role key as the backend (often sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=
# MUST match backend AGENT_KMS_KEY (32-byte hex = 64 hex chars)
AGENT_KMS_KEY=
# Required by worker config (unlike backend, which has hardcoded builder defaults)
HL_BUILDER_ADDRESS=0xYourBuilderAddress
HL_BUILDER_FEE_TENTHS_BPS=30
HL_ENV=mainnet

# --- Market data for the worker ---
COINGLASS_GLOBAL_MODE=1
COINGLASS_HOUSE_KEY=your-coinglass-standard-key
MASSIVE_API_KEY=your-massive-api-key

# --- House LLM keys (at least one provider the agents will use) ---
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=

# --- Runtime / safety ---
# FORCE_DRY_RUN=0                             # 1 = force shadow mode for all agents this process
# HL_WEIGHT_PER_MINUTE=1100                   # HL IP weight budget; ~1100 on dedicated egress
# CYCLE_MINUTES=60
# AGENT_CONCURRENCY=5
# MIN_HL_BALANCE_USD=50

# =============================================================================
# Not read by current worker config (safe to omit)
# =============================================================================
# DRY_RUN_DEFAULT=0                           # unused — use DB dry_run + FORCE_DRY_RUN

# ── Execution / book gate / calibration data (2026-09, docs/AI_AGENTS.md) ────
# Maker-first opens: ALO at the touch, wait MAKER_WAIT_MS, cancel, IOC remainder. 0 = IOC only.
MAKER_FIRST_OPEN=1
MAKER_WAIT_MS=20000
# Live L2 gate on fresh opens (skipped_thin_book). Closes are never gated.
BOOK_GATE_ENABLED=1
BOOK_MIN_DEPTH_MULT=3
# Optional global spread cap in bps (unset = per-tier defaults: 15 / 35 / 80 / HIP-3 100)
# BOOK_MAX_SPREAD_BPS=
# ai_signal_snapshots writes + forward-return backfill (migration backend/migrations/ai_signal_snapshots.sql)
SIGNAL_SNAPSHOTS_ENABLED=1
