{
  "expo": {
    "name": "HyperTrade",
    "slug": "hyper-rwa",
    "version": "2.3.4",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hypertrade",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.exchange.hypertrade",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "NSFaceIDUsageDescription": "Secure login with Face ID",
      "ITSAppUsesNonExemptEncryption": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera is used to scan QR codes and to capture your ID and selfie during identity verification",
        "NSMicrophoneUsageDescription": "Microphone is used to record the liveness video during identity verification",
        "NSPhotoLibraryUsageDescription": "Photo library access lets you upload identity documents during verification",
        "NSLocationWhenInUseUsageDescription": "Your location is used to confirm your home address during identity verification",
        "NFCReaderUsageDescription": "NFC is used to read the secure chip in your passport or ID during identity verification",
        "LSApplicationQueriesSchemes": [
          "alipay",
          "alipays",
          "alipayhk",
          "shoebox",
          "wallet",
          "googlewallet",
          "metamask",
          "trust",
          "okex",
          "rainbow",
          "phantom",
          "cbwallet",
          "zerion"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hypertrade.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#5CE1E6"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-appsflyer",
        {}
      ],
      "./plugins/withAppsFlyerManifestFix",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0a0e14"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HyperTrade to access your camera to scan QR codes for wallet addresses"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5CE1E6",
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      "./plugins/withFirebaseModularHeaders",
      "expo-localization",
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes *Annotation*\n-keepattributes SourceFile,LineNumberTable\n-keep class expo.modules.securestore.** { *; }\n-keep class expo.modules.crypto.** { *; }\n-keep class com.appsflyer.** { *; }\n-keepclassmembers class com.appsflyer.** { *; }\n-keep class kotlin.jvm.internal.** { *; }\n-dontwarn com.appsflyer.**\n-keep class com.sumsub.** { *; }\n-keepclassmembers class com.sumsub.** { *; }\n-dontwarn com.sumsub.**\n-keep class com.twilio.** { *; }\n-dontwarn com.twilio.**\n-keep class com.sun.jna.** { *; }\n-keepclassmembers class com.sun.jna.** { native <methods>; *; }\n-keep class uniffi.** { *; }\n-dontwarn uniffi.**\n-dontwarn com.sun.jna.**\n-keep class com.google.android.gms.fido.** { *; }\n-keep class androidx.credentials.** { *; }",
            "extraMavenRepos": [
              "https://maven.sumsub.com/repository/maven-releases/"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withSumsubPodSource",
      "./plugins/withMlkitVisionDependencies",
      "./plugins/withSumsubNfc"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31d054e7-5d8d-468a-8270-f1d1511c7971"
      },
      "EXPO_PUBLIC_MANTLE_CHAIN_ID": "5000",
      "EXPO_PUBLIC_UR_SOURCE_CHAIN_ID": "42161"
    },
    "owner": "hannarich"
  }
}
