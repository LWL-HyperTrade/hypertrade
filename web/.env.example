# BuilderPad web (Vite). Copy to web/.env for local dev.
# On Vercel, set the same names. Only VITE_* is visible to the browser.
# Restart Vite after changes. Production: redeploy so the values are baked in.

# Required. Same Privy App ID as the mobile app and the API. Not the Expo client ID.
VITE_PRIVY_APP_ID=

# Required on Vercel. FastAPI origin, no /api suffix and no trailing slash.
# Local npm run dev can leave this empty and use the Vite /api proxy.
VITE_BACKEND_URL=https://your-api.example.com

# Apex host. Console is https://{this}; apps are https://{slug}.{this}.
# Unset defaults to builderpad.xyz.
VITE_TENANT_BASE_DOMAIN=builderpad.xyz

# 1 = show the AI resident card on My Apps. Public resident pages render either way.
# The API (Railway), not Vercel, also needs BUILDERPAD_RESIDENTS_ENABLED=1.
VITE_BUILDERPAD_RESIDENTS=1

# Optional. Arbitrum USDC reads in the wallet sheet. Unset uses the public RPC.
VITE_ARBITRUM_RPC_URL=

# Optional. Robinhood Chain (4663) RPC for token reads and sends. Not an Arbitrum URL.
# Not the Foundry ROBINHOOD_RPC_URL.
VITE_ROBINHOOD_RPC_URL=

# Optional. WalletConnect Cloud project ID for the wallet-connect login entry.
# Unset uses Privy's shared project. Allowlist builderpad.xyz and *.builderpad.xyz.
VITE_WALLETCONNECT_PROJECT_ID=
