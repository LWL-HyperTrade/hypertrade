# BuilderPad Vite console (create / list / preview). Copy to web/.env
# Same Privy App ID as Expo + backend. This is NOT a trading client.

# Required to log in and call /api/tenants*
VITE_PRIVY_APP_ID=
VITE_BACKEND_URL=http://localhost:8000

# Optional. Privy → Configuration → App settings → Clients → create a **Web**
# client. Do NOT paste the Expo/mobile client ID.
# VITE_PRIVY_CLIENT_ID=

# Host shown on /t/{slug} trading-skin links (Expo app).
# TODO(builderpad-domain): switch when that domain is ready.
VITE_TENANT_PUBLIC_ORIGIN=https://app.hypertrade.exchange

# --- OrbCast web has these; skip them here ---
# VITE_SUPABASE_URL          — browser never talks to Supabase (FastAPI + service_role)
# VITE_HL_NETWORK            — no HL order signing in this console
# VITE_HL_BUILDER_ADDRESS    — assigned/read-only from /api/builder-config (shared builder)
# VITE_HL_BUILDER_FEE_TENTHS_BPS — creator sets 0-10 bps in the wizard
# VITE_ARBITRUM_RPC_URL      — no wallet USDC / Bridge2 reads here (not Robinhood —
#                              Alchemy / Infura / QuickNode / public arb1 if we add deposits later)
